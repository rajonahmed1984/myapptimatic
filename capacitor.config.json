{
  "appId": "com.apptimatic.app",
  "appName": "MyApptimatic",
  "webDir": "mobile/www",
  "server": {
    "url": "https://my.apptimatic.com",
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false,
    "errorPath": "index.html",
    "allowNavigation": [
      "*.sslcommerz.com",
      "*.bka.sh",
      "*.paypal.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#f8fafc",
    "appendUserAgent": "MyApptimaticApp"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#f8fafc",
    "limitsNavigationsToAppBoundDomains": false,
    "appendUserAgent": "MyApptimaticApp"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#302B87",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0d9488",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
